{
    "name": "spocket/wordpress-plugin-phpcs",
    "description": "Lint/format toolchain for the Spocket WordPress plugin. Deliberately SEPARATE from the plugin's own composer.json.",
    "type": "project",
    "license": "proprietary",
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.7",
        "wp-coding-standards/wpcs": "^3.0",
        "automattic/vipwpcs": "^3.0",
        "woocommerce/woocommerce-sniffs": "^1.0",
        "phpcompatibility/phpcompatibility-wp": "^2.1"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
