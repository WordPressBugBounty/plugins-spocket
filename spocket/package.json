{
  "name": "spocket",
  "private": true,
  "scripts": {
    "phpcs:install": "composer install --working-dir=tools/phpcs",
    "test": "./tools/phpcs/vendor/bin/phpcs --standard=./phpcs.xml --warning-severity=0 --ignore-annotations .",
    "fix_errors": "./tools/phpcs/vendor/bin/phpcbf --standard=./phpcs.xml .",
    "format": "./tools/phpcs/vendor/bin/phpcbf --standard=./phpcs-format.xml .",
    "format:check": "./tools/phpcs/vendor/bin/phpcs --standard=./phpcs-format.xml .",
    "build": "cross-env NODE_ENV=production webpack --config webpack.config.js --progress --mode production",
    "build:dev": "cross-env NODE_ENV=development webpack --config webpack.config.js --progress --mode development",
    "watch": "npm run build -- --watch",
    "watch:dev": "cross-env NODE_ENV=development webpack-dev-server --config webpack.config.js --progress --mode development",
    "lint": "eslint --ext .js,.vue --ignore-path .eslintignore .",
    "autofix": "eslint --fix --ext .js,.vue --ignore-path .eslintignore .",
    "wp_plugins": "./get_wp_plugins.sh",
    "deploy": "./deploy.sh"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "core-js": "^3.50.0",
    "query-string": "^7.1.3",
    "sweetalert2": "^11.7.32",
    "vue": "^2.7.14"
  },
  "devDependencies": {
    "@babel/core": "^7.23.5",
    "@babel/plugin-proposal-object-rest-spread": "^7.20.7",
    "@babel/preset-env": "^7.23.5",
    "@mapbox/stylelint-processor-arbitrary-tags": "^0.4.0",
    "autoprefixer": "^10.4.16",
    "babel-loader": "^9.1.3",
    "babel-plugin-syntax-object-rest-spread": "^6.13.0",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^7.0.3",
    "css-loader": "^6.8.1",
    "dotenv": "^16.3.1",
    "dotenv-webpack": "^8.0.1",
    "eslint": "^8.51.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-vue": "^9.18.1",
    "file-loader": "^6.2.0",
    "html-loader": "^4.2.0",
    "mini-css-extract-plugin": "^2.7.6",
    "postcss": "^8.5.23",
    "postcss-loader": "^7.3.3",
    "sass": "^1.69.5",
    "sass-loader": "^13.3.2",
    "style-loader": "^3.3.3",
    "stylelint": "^15.11.0",
    "stylelint-config-standard": "^34.0.0",
    "stylelint-order": "^6.0.0",
    "stylelint-webpack-plugin": "^5.1.0",
    "vue-loader": "^15.10.1",
    "vue-template-compiler": "^2.7.14",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^6.0.0"
  },
  "overrides": {
    "js-yaml": ">=4.3.2 <5",
    "baseline-browser-mapping": ">=2.11.0 <3",
    "qs": ">=6.16.0 <7",
    "colord": ">=2.9.4 <3",
    "browserslist": ">=4.28.7 <5",
    "fast-uri": ">=3.1.6 <4",
    "brace-expansion": ">=1.1.18 <2",
    "decode-uri-component": ">=0.5.0 <1",
    "nanoid": ">=3.3.18 <4",
    "postcss": "$postcss"
  }
}
